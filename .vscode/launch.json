{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Run n8n-launcher",
      "command": "cargo run --manifest-path \"${workspaceFolder}/rust/n8n-launcher-workspace/Cargo.toml\" --bin n8n-launcher",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Self-test n8n-launcher (headless)",
      "command": "cargo run --manifest-path \"${workspaceFolder}/rust/n8n-launcher-workspace/Cargo.toml\" --bin n8n-launcher -- --self-test",
      "env": {
        "QT_QPA_PLATFORM": "offscreen"
      },
      "cwd": "${workspaceFolder}"
    }
  ]
}
